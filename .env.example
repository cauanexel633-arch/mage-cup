# SMTP server configuration
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=senha_de_app_do_gmail

# Display name + sender address.
# Use the same mailbox as SMTP_USER for simplest setup.
FROM_EMAIL=Mage Cup <seuemail@gmail.com>

# OTP configuration
OTP_SECRET=coloque-um-segredo-grande-e-aleatorio-aqui
OTP_TTL_SECONDS=600
